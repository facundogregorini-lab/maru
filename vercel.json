{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "sh scripts/vercel-ignore-build.sh",
  "crons": [
    {
      "path": "/api/cron/semanal",
      "schedule": "0 10 * * 1"
    },
    {
      "path": "/api/cron/alertas",
      "schedule": "0 14 * * 1"
    },
    {
      "path": "/api/cron/secuencias",
      "schedule": "0 13 * * 1-5"
    },
    {
      "path": "/api/cron/radar",
      "schedule": "23 10 * * *"
    }
  ]
}
