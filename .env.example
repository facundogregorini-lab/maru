ANTHROPIC_API_KEY=sk-ant-...
# Opcional: otro modelo
# ANTHROPIC_MODEL=claude-opus-5-5

# Login con magic link (obligatorio para descargar el CV)
# Generalo con: openssl rand -base64 48
AUTH_SECRET=
# SMTP para mandar el link. Ej. Brevo: smtps://USUARIO:CLAVE_SMTP@smtp-relay.brevo.com:465
# Sin SMTP_URL en desarrollo, el link se imprime en la consola del servidor.
SMTP_URL=
EMAIL_FROM="Maru <hola@tudominio.com>"
# Opcional: "Continuar con Google" (ID de cliente OAuth, tipo aplicación web, en Google Cloud).
# URI de redirección autorizada: https://TU-DOMINIO/api/auth/google/callback (y http://localhost:3000/api/auth/google/callback para desarrollo)
# Sin estas dos, el botón no aparece y queda sólo el magic link.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Encontrá tu trabajo perfecto (/match)
# Emails con acceso al panel /match/admin (separados por coma)
ADMIN_EMAILS=
# Opcional: pesos del ranking (habilidades,intención,seniority,extras)
# MATCH_WEIGHTS=40,35,15,10
# Opcional: apagar fuentes sin tocar código
# MATCH_DISABLED_SOURCES=
