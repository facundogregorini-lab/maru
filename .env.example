ANTHROPIC_API_KEY=sk-ant-...
# Opcional: otro modelo
# ANTHROPIC_MODEL=claude-opus-5-5

# Login con Google (obligatorio para descargar el CV). Firma las sesiones.
# Generalo con: openssl rand -base64 48
AUTH_SECRET=
# "Continuar con Google" (ID de cliente OAuth, tipo aplicación web, en Google Cloud). Es el único ingreso.
# URI de redirección autorizada: https://TU-DOMINIO/api/auth/google/callback (y http://localhost:3000/api/auth/google/callback para desarrollo)
# Sin estas dos, nadie puede ingresar: el diálogo avisa que el ingreso no está disponible.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Base de datos (Upstash Redis): guarda perfil, match y seguimiento de cada cuenta para verlos en cualquier dispositivo.
# En Vercel: Storage → Create Database → Upstash for Redis → conectarla al proyecto (agrega estas dos solas).
# Sin estas variables, en desarrollo usa una base en memoria; en producción Maru sigue andando sólo con el navegador.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Encontrá tu trabajo perfecto (/match)
# Emails con acceso al panel /match/admin (comas, espacios o saltos de línea)
ADMIN_EMAILS=
# Opcional: pesos del ranking (habilidades,intención,seniority,extras)
# MATCH_WEIGHTS=40,35,15,10
# Opcional: apagar fuentes sin tocar código
# MATCH_DISABLED_SOURCES=

# Planes y cobro: mantener false hasta validar la cuenta, los textos comerciales y el circuito de pago.
# El cambio de NEXT_PUBLIC_* exige un nuevo build/deploy.
NEXT_PUBLIC_BILLING_ENABLED=false
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
# URL pública canónica, también usada para volver de Mercado Pago.
NEXT_PUBLIC_SITE_URL=https://maru-grego7.vercel.app
# Contacto público para soporte y legales.
NEXT_PUBLIC_CONTACT_EMAIL=

# Piloto manual de avisos de Apify (scripts/apify-jobs.ts). Sólo servidor/CLI.
# La conexión OAuth de Codex es independiente. Nunca usar NEXT_PUBLIC_APIFY_TOKEN.
# APIFY_TOKEN=

# Pruebas manuales privadas en /match/admin. Nunca NEXT_PUBLIC_*.
FANTASTIC_JOBS=
SERP_API=

# PostHog (funnels de producto). Clave pública del proyecto (phc_…): viaja al navegador.
# Sólo envía eventos en los dominios de NEXT_PUBLIC_GOOGLE_ADS_HOSTS. Sin la clave no se carga. Ver docs/TRACKING.md.
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Google Ads (etiqueta de Google directa, sin GTM). No son secretos: viajan al navegador.
# Sin el ID la etiqueta no se carga. Sólo en Production: el script además exige www.marucoach.com / marucoach.com.
# Cambiarlos exige un nuevo deploy. Detalle, mapeo y pruebas: docs/TRACKING.md.
# NEXT_PUBLIC_GOOGLE_ADS_ID=AW-18500028132
# NEXT_PUBLIC_GOOGLE_ADS_LABEL_ACTIVATION=xDWcCOnckKAdEOSNwPVE
# NEXT_PUBLIC_GOOGLE_ADS_LABEL_PAYWALL=0QrpCObckKAdEOSNwPVE
# NEXT_PUBLIC_GOOGLE_ADS_LABEL_BEGIN_CHECKOUT=azVYCO_ckKAdEOSNwPVE
# NEXT_PUBLIC_GOOGLE_ADS_LABEL_PURCHASE=pbctCOzckKAdEOSNwPVE
# Opcional (por defecto www.marucoach.com,marucoach.com)
# NEXT_PUBLIC_GOOGLE_ADS_HOSTS=
