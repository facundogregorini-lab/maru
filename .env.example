ANTHROPIC_API_KEY=sk-ant-...
# Opcional: otro modelo
# ANTHROPIC_MODEL=claude-opus-5-5
# Opcional: modelo rápido para los turnos de la entrevista y el chat (si la cuenta no lo tiene, se usa el principal)
# ANTHROPIC_FAST_MODEL=claude-sonnet-5-5

# Login (obligatorio para descargar). Generalo con: openssl rand -base64 48
AUTH_SECRET=
# SMTP para el magic link y las alertas. Ej. Brevo: smtps://USUARIO:CLAVE_SMTP@smtp-relay.brevo.com:465
# Sin SMTP_URL en desarrollo, el email se imprime en la consola del servidor.
SMTP_URL=
EMAIL_FROM="Maru <hola@tudominio.com>"

# Ingreso con Google (Google Cloud → APIs y servicios → Credenciales → ID de cliente OAuth, aplicación web).
# URI de redireccionamiento autorizada: https://TU-DOMINIO/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Base de datos (Vercel → Storage → Upstash Redis): Vercel carga estas dos solas al conectarla.
# Sin base, Maru anda igual pero sin planes, límites, sincronización ni alertas.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Cobro con Mercado Pago (Tus integraciones → credenciales de producción). Sin esto no hay límites del plan gratis.
MP_ACCESS_TOKEN=
# Webhooks → evento "Planes y suscripciones" → URL https://TU-DOMINIO/api/pagos/webhook → clave secreta:
MP_WEBHOOK_SECRET=
# Alternativa mientras tanto: un link fijo de pago (sin API no se puede saber quién pagó).
# NEXT_PUBLIC_CHECKOUT_URL=

# Cron diario de alertas (Vercel lo manda en el header Authorization). Generalo con: openssl rand -hex 24
CRON_SECRET=

# Sitio y contacto
# NEXT_PUBLIC_SITE_URL=https://marucoach.com
# NEXT_PUBLIC_CONTACT_EMAIL=hola@marucoach.com

# Encontrá tu trabajo perfecto (/match)
# Emails con acceso al panel /match/admin (separados por coma)
ADMIN_EMAILS=
# Opcional: pesos del ranking (habilidades,intención,seniority,extras)
# MATCH_WEIGHTS=40,35,15,10
# Opcional: apagar fuentes sin tocar código
# MATCH_DISABLED_SOURCES=
