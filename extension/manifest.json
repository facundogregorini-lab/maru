{
  "manifest_version": 3,
  "name": "Maru Coach: completá postulaciones con tu CV",
  "short_name": "Maru Coach",
  "version": "0.4.0",
  "description": "Cargá tu CV una vez y completá formularios de postulación con un clic. Vos revisás y enviás.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Completar con Maru Coach"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "commands": {
    "fill": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "Completar el formulario de esta pestaña"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.marucoach.com/*",
        "https://marucoach.com/*",
        "https://maru-grego7.vercel.app/*",
        "http://localhost/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
