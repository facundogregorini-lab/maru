{
  "manifest_version": 3,
  "name": "Maru Coach: completá postulaciones con tu CV",
  "short_name": "Maru Coach",
  "version": "0.4.2",
  "description": "Cargá tu CV una vez y completá formularios de postulación con un clic. Vos revisás y enviás.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Completar con Maru Coach"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://www.marucoach.com/*",
    "https://marucoach.com/*",
    "http://localhost/*"
  ],
  "optional_host_permissions": [
    "https://*.greenhouse.io/*",
    "https://*.lever.co/*",
    "https://*.ashbyhq.com/*",
    "https://*.workable.com/*",
    "https://*.myworkdayjobs.com/*",
    "https://*.workday.com/*",
    "https://*.smartrecruiters.com/*",
    "https://*.teamtailor.com/*",
    "https://*.bamboohr.com/*",
    "https://*.recruitee.com/*",
    "https://*.jobvite.com/*",
    "https://*.icims.com/*",
    "https://*.successfactors.com/*",
    "https://*.successfactors.eu/*",
    "https://*.hiringroom.com/*",
    "https://*.breezy.hr/*",
    "https://*.personio.de/*",
    "https://*.personio.com/*",
    "https://*.gupy.io/*",
    "https://*.pinpointhq.com/*",
    "https://*.jazzhr.com/*",
    "https://*.applytojob.com/*",
    "https://*.bumeran.com.ar/*",
    "https://*.zonajobs.com.ar/*",
    "https://*.computrabajo.com/*"
  ],
  "commands": {
    "fill": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "Completar el formulario de esta pestaña"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.marucoach.com/*",
        "https://marucoach.com/*",
        "http://localhost/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
